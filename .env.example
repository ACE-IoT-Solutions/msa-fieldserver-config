# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Credentials used for every FieldServer unless overridden on the CLI.
FIELDSERVER_USERNAME=
FIELDSERVER_PASSWORD=

# Optional: comma-separated default host list, so you can run the CLI
# without repeating IPs. CLI args always win over this.
FIELDSERVER_HOSTS=

# Optional: http or https (default: http), and request timeout in seconds.
FIELDSERVER_SCHEME=http
FIELDSERVER_TIMEOUT=30

# Optional: set to 0 to skip TLS verification for self-signed device certs.
FIELDSERVER_VERIFY_TLS=1
